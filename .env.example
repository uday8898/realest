# Azure OpenAI (Azure portal -> your Azure OpenAI resource -> Keys and Endpoint)
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-03-01-preview
# Deployment NAMES (what you called them in Azure AI Foundry), not model names.
# Chat model must support vision + JSON mode (e.g. gpt-4o / gpt-4.1 / gpt-5-mini).
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
# Speech-to-text for voice notes: gpt-4o-transcribe or whisper
AZURE_OPENAI_TRANSCRIBE_DEPLOYMENT=gpt-4o-transcribe
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small   # optional; enables vector recall

# --- WhatsApp Business (Meta Cloud API): only needed for "Send from business number" ---
# Without these the app still works: "Open in WhatsApp" opens a chat with the text pre-filled.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=choose-any-string      # for the Meta webhook handshake
WHATSAPP_APP_SECRET=                          # verifies webhook signatures
# Messages to someone who hasn't written to the business number in 24h must be an approved template with ONE
# body variable {{1}} (e.g. "{{1}}"). Put its name here:
WHATSAPP_SHARE_TEMPLATE=
WHATSAPP_SHARE_TEMPLATE_LANG=en

# --- Public deployment (REQUIRED when the API is reachable from the internet) ---
# One shared code that unlocks the app. Without it the server refuses /api on any non-local host.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(24))"
APP_ACCESS_KEY=
# Frontend origin(s) allowed to call the API, comma separated (your Vercel URL).
CORS_ORIGINS=https://your-app.vercel.app
# 0 = start with an empty database instead of the demo brokers/listings.
SEED_DEMO=1
# Where the SQLite file lives. Point at a persistent disk if your host has one.
# WA_DB_PATH=/data/app.db
